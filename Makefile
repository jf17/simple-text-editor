CC      ?= clang
PKG     := gtk+-3.0
CFLAGS  += $(shell pkg-config --cflags $(PKG) 2>/dev/null)
LDFLAGS += $(shell pkg-config --libs $(PKG) 2>/dev/null)

TARGET  := simple-text-editor
SRC     := main.c
VERSION_H := version.h
GLADE   := editor.glade
ICON    := icon.png
DESKTOP := simple-text-editor.desktop
LICENSE := LICENSE

PREFIX      ?= /usr
BINDIR      := $(PREFIX)/bin
DATADIR     := $(PREFIX)/share/$(TARGET)
DOCDIR      := $(PREFIX)/share/doc/$(TARGET)
PIXMAPDIR   := $(PREFIX)/share/pixmaps
APPDIR      := $(PREFIX)/share/applications
ICONDIR     := $(PREFIX)/share/icons/hicolor/512x512/apps

# Version from latest git tag (v1.2.3 -> 1.2.3), fallback for shallow/no-git builds
GIT_VERSION := $(shell git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
PKG_NAME    := simple-text-editor
PKG_VERSION ?= $(if $(GIT_VERSION),$(GIT_VERSION),0.0.0)
PKG_ARCH    := $(shell dpkg-architecture -qDEB_HOST_ARCH 2>/dev/null || echo amd64)
DEB_DIR     := build/deb
DEB_ROOT    := $(DEB_DIR)/$(PKG_NAME)_$(PKG_VERSION)_$(PKG_ARCH)
DEB_FILE    := $(PKG_NAME)_$(PKG_VERSION)_$(PKG_ARCH).deb

.PHONY: help deps all clean run install deb FORCE

help:
	@echo "Version: $(PKG_VERSION)"
	@echo "Usage:"
	@echo "  make deps   - check build dependencies"
	@echo "  make all    - build $(TARGET)"
	@echo "  make run    - build and run"
	@echo "  make deb    - build .deb package ($(DEB_FILE))"
	@echo "  make clean  - remove binary and package artifacts"
	@echo "  make help   - show this help"

deps:
	@ok=1; \
	if ! command -v $(CC) >/dev/null 2>&1; then \
		echo "error: compiler '$(CC)' not found"; \
		echo "  install: sudo apt install clang"; \
		ok=0; \
	else \
		echo "ok: $(CC) ($$($(CC) --version | head -n1))"; \
	fi; \
	if ! command -v pkg-config >/dev/null 2>&1; then \
		echo "error: pkg-config not found"; \
		echo "  install: sudo apt install pkg-config"; \
		ok=0; \
	else \
		echo "ok: pkg-config"; \
	fi; \
	if ! command -v pkg-config >/dev/null 2>&1 || ! pkg-config --exists $(PKG); then \
		echo "error: $(PKG) not found"; \
		echo "  install: sudo apt install libgtk-3-dev"; \
		ok=0; \
	else \
		echo "ok: $(PKG) ($$(pkg-config --modversion $(PKG)))"; \
	fi; \
	if [ $$ok -eq 0 ]; then \
		echo ""; \
		echo "Fix missing dependencies and try again."; \
		exit 1; \
	fi; \
	echo "All dependencies OK"

all: deps $(TARGET)

# Regenerate when git tag / PKG_VERSION changes so About matches the real version
$(VERSION_H): FORCE
	@printf '%s\n' \
		'/* Generated by Makefile — do not edit */' \
		'#ifndef APP_VERSION' \
		'#define APP_VERSION "$(PKG_VERSION)"' \
		'#endif' > $@.tmp
	@if ! cmp -s $@.tmp $@ 2>/dev/null; then mv $@.tmp $@; else rm -f $@.tmp; fi

FORCE:

$(TARGET): $(SRC) $(VERSION_H)
	$(CC) $(CFLAGS) -o $@ $(SRC) $(LDFLAGS)

run: deps $(TARGET)
	./$(TARGET)

install: $(TARGET)
	install -d $(DESTDIR)$(BINDIR)
	install -d $(DESTDIR)$(DATADIR)
	install -d $(DESTDIR)$(DOCDIR)
	install -d $(DESTDIR)$(PIXMAPDIR)
	install -d $(DESTDIR)$(APPDIR)
	install -d $(DESTDIR)$(ICONDIR)
	install -m 755 $(TARGET) $(DESTDIR)$(BINDIR)/$(TARGET)
	install -m 644 $(GLADE) $(DESTDIR)$(DATADIR)/$(GLADE)
	install -m 644 $(ICON) $(DESTDIR)$(PIXMAPDIR)/$(TARGET).png
	install -m 644 $(ICON) $(DESTDIR)$(ICONDIR)/$(TARGET).png
	install -m 644 $(DESKTOP) $(DESTDIR)$(APPDIR)/$(DESKTOP)
	install -m 644 $(LICENSE) $(DESTDIR)$(DOCDIR)/copyright

deb: deps $(TARGET)
	@command -v dpkg-deb >/dev/null 2>&1 || { \
		echo "error: dpkg-deb not found"; \
		echo "  install: sudo apt install dpkg-dev"; \
		exit 1; \
	}
	rm -rf $(DEB_ROOT)
	$(MAKE) install DESTDIR=$(CURDIR)/$(DEB_ROOT) PREFIX=/usr
	install -d $(DEB_ROOT)/DEBIAN
	printf '%s\n' \
		'Package: $(PKG_NAME)' \
		'Version: $(PKG_VERSION)' \
		'Section: editors' \
		'Priority: optional' \
		'Architecture: $(PKG_ARCH)' \
		'Depends: libgtk-3-0' \
		'Maintainer: Simple Text Editor <noreply@localhost>' \
		'Description: Simple GTK3 text editor' \
		' A minimal text editor built with GTK3 and Glade.' \
		> $(DEB_ROOT)/DEBIAN/control
	fakeroot dpkg-deb --build $(DEB_ROOT) $(DEB_FILE)
	@echo "Built: $(DEB_FILE)"

clean:
	rm -f $(TARGET) $(VERSION_H) $(PKG_NAME)_*_*.deb
	rm -rf build
